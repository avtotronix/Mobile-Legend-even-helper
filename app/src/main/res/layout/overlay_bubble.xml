<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_bg"
    android:elevation="12dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- Play/Pause Status Indicator -->
    <TextView
        android:id="@+id/tvBubbleStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:text="@string/bubble_status_active"
        android:textColor="@color/text_white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Toggle Action Button -->
    <Button
        android:id="@+id/btnBubblePause"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/cd_toggle_pause"
        android:gravity="center"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="⏸"
        android:textColor="@color/accent"
        android:textSize="16sp" />

    <!-- Close Button -->
    <Button
        android:id="@+id/btnBubbleClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/cd_close_overlay"
        android:gravity="center"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="✕"
        android:textColor="@color/red_stop"
        android:textSize="16sp" />

</LinearLayout>
